#!/bin/sh
# emacs-devtools-mcp -- stdio <-> Unix-socket relay for the MCP host.
#
# Usage: invoked by an MCP client (e.g. Claude Code) via the `command'
# field of an `.mcp.json' entry.  Reads MCP frames on stdin, relays
# them to the host Emacs's Unix-domain socket at
# `${XDG_RUNTIME_DIR}/edmcp/${EDMCP_NAME:-default}.sock', and writes
# replies to stdout.  Injects the per-launch authentication token into
# `params._meta.token' of the first `initialize' request.  Lines before
# it are forwarded unchanged; everything after it streams through.
#
# Hard-fails (no /tmp fallback) if `XDG_RUNTIME_DIR' is unset, the
# socket is missing, or the token file is unreadable.

set -eu

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  printf 'emacs-devtools-mcp: XDG_RUNTIME_DIR is unset (macOS/BSD: export it to a private mode-0700 directory you own, for both Emacs and this relay)\n' >&2
  exit 1
fi

NAME="${EDMCP_NAME:-default}"

# Reject any NAME outside [A-Za-z0-9_-]+ so a hostile env var can't
# escape the per-user $XDG_RUNTIME_DIR/edmcp/ directory via "../" or
# slip in shell metacharacters that would later trip socat / jq.
case "$NAME" in
  '' | *[!A-Za-z0-9_-]*)
    printf 'emacs-devtools-mcp: invalid EDMCP_NAME %s (allowed: [A-Za-z0-9_-]+)\n' \
      "$NAME" >&2
    exit 1
    ;;
esac

SOCK="${XDG_RUNTIME_DIR}/edmcp/${NAME}.sock"
TOKEN_FILE="${XDG_RUNTIME_DIR}/edmcp/${NAME}.token"

if [ ! -S "$SOCK" ]; then
  printf 'emacs-devtools-mcp: no socket at %s -- is the host server running?\n' \
    "$SOCK" >&2
  exit 1
fi

if [ ! -r "$TOKEN_FILE" ]; then
  printf 'emacs-devtools-mcp: no readable token file at %s\n' "$TOKEN_FILE" >&2
  exit 1
fi

TOKEN="$(cat -- "$TOKEN_FILE")"
if [ -z "$TOKEN" ]; then
  printf 'emacs-devtools-mcp: token file %s is empty\n' "$TOKEN_FILE" >&2
  exit 1
fi

for cmd in jq socat; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf 'emacs-devtools-mcp: required command "%s" not on PATH\n' "$cmd" >&2
    exit 1
  fi
done

{
  while IFS= read -r line; do
    method="$(printf '%s' "$line" \
      | jq -r 'if type == "object" then .method // "" else "" end' \
          2>/dev/null || true)"
    if [ "$method" = "initialize" ]; then
      printf '%s' "$line" \
        | jq -c --arg tok "$TOKEN" \
            '.params = ((.params // {}) | ._meta = ((._meta // {}) | .token = $tok))'
      exec cat
    fi
    printf '%s\n' "$line"
  done
} | exec socat - UNIX-CONNECT:"$SOCK"
